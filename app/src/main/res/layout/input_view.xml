<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_bg_dark">

    <LinearLayout
        android:id="@+id/accessory_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/accessory_strip_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/kb_surface_dark"
        android:paddingHorizontal="6dp">

        <LinearLayout
            android:id="@+id/suggestion_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/btn_mode_advanced"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="ADV"
            android:textColor="@color/kb_accent_dark"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_mode_editing"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="EDIT"
            android:textColor="@color/kb_text_secondary_dark"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_settings_quick"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="⚙"
            android:textColor="@color/kb_text_secondary_dark"
            android:textSize="15sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/modifier_scroll_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/modifier_strip_height"
        android:background="@color/kb_surface_dark"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/modifier_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/keyboard_content_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="2dp" />

</LinearLayout>
